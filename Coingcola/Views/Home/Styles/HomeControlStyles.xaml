<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="HomePanelBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Home.CardBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource Home.CardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource Home.PanelCornerRadius}" />
        <Setter Property="Padding" Value="{StaticResource Home.PanelPadding}" />
    </Style>

    <Style x:Key="HomeSectionTitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource Home.SectionTitleFontSize}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Home.TextPrimaryBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="HomeSectionHintTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource Home.CaptionFontSize}" />
        <Setter Property="Foreground" Value="{StaticResource Home.TextTertiaryBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="HomeListButtonStyle" TargetType="Button">
        <Setter Property="MinHeight" Value="{StaticResource Home.RecentItemMinHeight}" />
        <Setter Property="Padding" Value="{StaticResource Home.ItemPadding}" />
        <Setter Property="Background" Value="{StaticResource Home.CardBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource Home.CardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style x:Key="HomeQuickActionButtonStyle" TargetType="Button">
        <Setter Property="MinHeight" Value="{StaticResource Home.QuickActionMinHeight}" />
        <Setter Property="Padding" Value="{StaticResource Home.ItemPadding}" />
        <Setter Property="Background" Value="{StaticResource Home.CardBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource Home.CardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
</ResourceDictionary>
