<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="SearchResultContainerStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Home.CardBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource Home.CardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource Home.PanelCornerRadius}" />
        <Setter Property="Padding" Value="{StaticResource Home.PanelPadding}" />
    </Style>

    <Style x:Key="SearchResultButtonStyle" TargetType="Button">
        <Setter Property="MinHeight" Value="56" />
        <Setter Property="Padding" Value="{StaticResource Home.ItemPadding}" />
        <Setter Property="Background" Value="{StaticResource Home.CardMutedBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource Home.CardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style x:Key="SearchHistoryButtonStyle" TargetType="Button" BasedOn="{StaticResource HomeListButtonStyle}">
        <Setter Property="MinHeight" Value="52" />
    </Style>
</ResourceDictionary>
