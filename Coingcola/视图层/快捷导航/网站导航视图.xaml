<UserControl x:Class="Coingcola.视图层.快捷导航.网站导航视图"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="Transparent">

    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 顶部标题区 -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="管理常用网站"
                       FontSize="28"
                       FontWeight="Bold"
                       Foreground="#0F172A"/>

            <TextBlock Text="保存常用网址，支持输入完整网址、域名、关键字，未识别时自动走搜索引擎。"
                       Margin="0,10,0,0"
                       FontSize="14"
                       TextWrapping="Wrap"
                       Foreground="#64748B"/>
        </StackPanel>

        <!-- 输入与识别区 -->
        <Border Grid.Row="1"
                Background="#F8FAFC"
                BorderBrush="#CBD5E1"
                BorderThickness="1"
                CornerRadius="20"
                Padding="20"
                Margin="0,0,0,20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="输入框"
                             Grid.Column="0"
                             Height="42"
                             Margin="0,0,12,0"
                             Padding="12,8"
                             VerticalContentAlignment="Center"
                             FontSize="14"
                             TextChanged="输入框_TextChanged"/>

                    <Button x:Name="打开按钮"
                            Grid.Column="1"
                            Content="打开"
                            Width="96"
                            Height="42"
                            Margin="0,0,12,0"
                            Click="打开按钮_Click"
                            Background="#0F172A"
                            Foreground="White"
                            BorderThickness="0"
                            FontSize="14"
                            FontWeight="SemiBold"/>

                    <Button x:Name="添加按钮"
                            Grid.Column="2"
                            Content="添加到导航"
                            Width="120"
                            Height="42"
                            Click="添加按钮_Click"
                            Background="#2563EB"
                            Foreground="White"
                            BorderThickness="0"
                            FontSize="14"
                            FontWeight="SemiBold"/>
                </Grid>

                <TextBlock Grid.Row="1"
                           Margin="0,12,0,0"
                           Text="示例：github / github.com / https://github.com / 显卡天梯图"
                           FontSize="12"
                           Foreground="#94A3B8"/>

                <Border Grid.Row="2"
                        Margin="0,14,0,0"
                        Background="White"
                        BorderBrush="#E2E8F0"
                        BorderThickness="1"
                        CornerRadius="16"
                        Padding="14">
                    <StackPanel>
                        <TextBlock Text="识别结果"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="#334155"/>

                        <TextBlock x:Name="识别结果文本"
                                   Margin="0,8,0,0"
                                   Text="等待输入..."
                                   FontSize="13"
                                   TextWrapping="Wrap"
                                   Foreground="#64748B"/>

                        <TextBlock x:Name="识别说明文本"
                                   Margin="0,8,0,0"
                                   Text=""
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Foreground="#94A3B8"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- 已保存网站列表 -->
        <Border Grid.Row="2"
                Background="White"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                CornerRadius="20"
                Padding="20">
            <DockPanel LastChildFill="True">
                <Grid DockPanel.Dock="Top" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="已保存网站"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="#0F172A"/>

                        <TextBlock x:Name="网站数量文本"
                                   Margin="0,6,0,0"
                                   Text="共 0 个网站"
                                   FontSize="12"
                                   Foreground="#64748B"/>
                    </StackPanel>

                    <Button Grid.Column="1"
                            Content="刷新列表"
                            Width="96"
                            Height="36"
                            Background="White"
                            Foreground="#334155"
                            BorderBrush="#CBD5E1"
                            Click="刷新按钮_Click"/>
                </Grid>

                <ListBox x:Name="网站列表框"
                         BorderThickness="0"
                         Background="Transparent"
                         HorizontalContentAlignment="Stretch"
                         SelectionChanged="网站列表框_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,12"
                                    Padding="16"
                                    CornerRadius="18"
                                    Background="#F8FAFC"
                                    BorderBrush="#E2E8F0"
                                    BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="56"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0"
                                            Width="48"
                                            Height="48"
                                            CornerRadius="14"
                                            Background="White"
                                            BorderBrush="#E2E8F0"
                                            BorderThickness="1">
                                        <TextBlock Text="{Binding 名称}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontSize="11"
                                                   FontWeight="Bold"
                                                   Foreground="#334155"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </Border>

                                    <StackPanel Grid.Column="1" Margin="14,0,12,0">
                                        <TextBlock Text="{Binding 名称}"
                                                   FontSize="15"
                                                   FontWeight="Bold"
                                                   Foreground="#0F172A"/>

                                        <TextBlock Text="{Binding 地址}"
                                                   Margin="0,6,0,0"
                                                   FontSize="12"
                                                   TextWrapping="Wrap"
                                                   Foreground="#64748B"/>

                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                            <Border Background="#E2E8F0"
                                                    CornerRadius="10"
                                                    Padding="8,2"
                                                    Margin="0,0,8,0">
                                                <TextBlock Text="{Binding 分组}"
                                                           FontSize="11"
                                                           Foreground="#475569"/>
                                            </Border>

                                            <Border Background="#DBEAFE"
                                                    CornerRadius="10"
                                                    Padding="8,2">
                                                <TextBlock Text="{Binding 关键字}"
                                                           FontSize="11"
                                                           Foreground="#1D4ED8"/>
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2"
                                                Orientation="Horizontal"
                                                VerticalAlignment="Center">
                                        <Button Content="打开"
                                                Tag="{Binding Id}"
                                                Width="72"
                                                Height="34"
                                                Margin="0,0,8,0"
                                                Background="#0F172A"
                                                Foreground="White"
                                                BorderThickness="0"
                                                Click="列表打开按钮_Click"/>

                                        <Button Content="删除"
                                                Tag="{Binding Id}"
                                                Width="72"
                                                Height="34"
                                                Background="White"
                                                Foreground="#DC2626"
                                                BorderBrush="#FCA5A5"
                                                Click="列表删除按钮_Click"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
