<UserControl x:Class="Coingcola.视图层.开始使用.WPS快捷键视图"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="Transparent">

    <!--
        WPS 快捷键视图：
        当前优化目标：
        1. 卡片更紧凑，便于扫读
        2. 支持分类筛选
        3. 优先本地知识库，未命中再网络检索
    -->

    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="WPS快捷键"
                       FontSize="30"
                       FontWeight="Bold"
                       Foreground="#0F172A"/>

            <TextBlock Text="常用快捷键本地知识库，优先本地检索，未命中再网络检索。"
                       Margin="0,10,0,0"
                       FontSize="14"
                       Foreground="#64748B"/>
        </StackPanel>

        <!-- 搜索区 -->
        <Border Grid.Row="1"
                Background="#F8FAFC"
                BorderBrush="#CBD5E1"
                BorderThickness="1"
                CornerRadius="20"
                Padding="18"
                Margin="0,0,0,16">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="搜索输入框"
                             Grid.Column="0"
                             Height="40"
                             Padding="12,8"
                             FontSize="14"
                             VerticalContentAlignment="Center"
                             KeyDown="搜索输入框_KeyDown"/>

                    <Button Grid.Column="1"
                            Width="88"
                            Height="40"
                            Margin="12,0,0,0"
                            Content="检索"
                            Click="检索按钮_Click"
                            Background="#0F172A"
                            Foreground="White"
                            BorderThickness="0"/>

                    <Button Grid.Column="2"
                            Width="88"
                            Height="40"
                            Margin="12,0,0,0"
                            Content="重置"
                            Click="重置按钮_Click"
                            Background="White"
                            Foreground="#334155"
                            BorderBrush="#CBD5E1"/>

                    <Button Grid.Column="3"
                            Width="110"
                            Height="40"
                            Margin="12,0,0,0"
                            Content="网络检索"
                            Click="网络检索按钮_Click"
                            Background="#2563EB"
                            Foreground="White"
                            BorderThickness="0"/>
                </Grid>

                <TextBlock x:Name="结果说明文本"
                           Margin="0,12,0,0"
                           Text="正在加载本地知识库..."
                           FontSize="12"
                           TextWrapping="Wrap"
                           Foreground="#64748B"/>
            </StackPanel>
        </Border>

        <!-- 分类筛选 -->
        <Border Grid.Row="2"
                Background="White"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                CornerRadius="20"
                Padding="16"
                Margin="0,0,0,16">
            <WrapPanel>
                <Button x:Name="全部分类按钮"
                        Content="全部"
                        Width="72"
                        Height="34"
                        Margin="0,0,10,10"
                        Click="全部分类按钮_Click"/>

                <Button x:Name="通用分类按钮"
                        Content="通用"
                        Width="72"
                        Height="34"
                        Margin="0,0,10,10"
                        Click="通用分类按钮_Click"/>

                <Button x:Name="文字分类按钮"
                        Content="文字"
                        Width="72"
                        Height="34"
                        Margin="0,0,10,10"
                        Click="文字分类按钮_Click"/>

                <Button x:Name="表格分类按钮"
                        Content="表格"
                        Width="72"
                        Height="34"
                        Margin="0,0,10,10"
                        Click="表格分类按钮_Click"/>

                <Button x:Name="演示分类按钮"
                        Content="演示"
                        Width="72"
                        Height="34"
                        Margin="0,0,10,10"
                        Click="演示分类按钮_Click"/>
            </WrapPanel>
        </Border>

        <!-- 卡片区 -->
        <Border Grid.Row="3"
                Background="White"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                CornerRadius="20"
                Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="快捷键卡片"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="#0F172A"/>

                    <TextBlock x:Name="结果数量文本"
                               Grid.Column="1"
                               Text="共 0 条"
                               FontSize="12"
                               VerticalAlignment="Center"
                               Foreground="#64748B"/>
                </Grid>

                <Grid Grid.Row="1" Margin="0,16,0,0">
                    <TextBlock x:Name="空结果文本"
                               Text="本地知识库未命中，你可以继续点击“网络检索”。"
                               Visibility="Collapsed"
                               FontSize="13"
                               Foreground="#64748B"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="快捷键列表控件">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>

                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="235"
                                            Height="110"
                                            Margin="0,0,12,12"
                                            Padding="14"
                                            CornerRadius="18"
                                            Background="#F8FAFC"
                                            BorderBrush="#E2E8F0"
                                            BorderThickness="1">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>

                                            <Grid Grid.Row="0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Text="{Binding 功能名称}"
                                                           FontSize="14"
                                                           FontWeight="Bold"
                                                           Foreground="#0F172A"
                                                           TextTrimming="CharacterEllipsis"/>

                                                <Border Grid.Column="1"
                                                        Background="#E2E8F0"
                                                        CornerRadius="8"
                                                        Padding="8,2"
                                                        Margin="8,0,0,0">
                                                    <TextBlock Text="{Binding 分类}"
                                                               FontSize="11"
                                                               Foreground="#475569"/>
                                                </Border>
                                            </Grid>

                                            <Border Grid.Row="1"
                                                    Background="#0F172A"
                                                    CornerRadius="10"
                                                    Padding="10,5"
                                                    Margin="0,10,0,0"
                                                    HorizontalAlignment="Left">
                                                <TextBlock Text="{Binding 快捷键}"
                                                           FontSize="12"
                                                           FontWeight="Bold"
                                                           Foreground="White"/>
                                            </Border>

                                            <TextBlock Grid.Row="2"
                                                       Text="{Binding 说明}"
                                                       Margin="0,10,0,0"
                                                       FontSize="11"
                                                       TextWrapping="Wrap"
                                                       Foreground="#64748B"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>