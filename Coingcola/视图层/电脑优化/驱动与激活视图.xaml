<UserControl x:Class="Coingcola.视图层.电脑优化.驱动与激活视图"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="Transparent">

    <!--
        驱动与激活视图：
        当前先完成：
        1. 系统激活状态展示
        2. 驱动问题扫描结果展示
        3. 跳转到激活设置 / 设备管理器
    -->

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Background="Transparent">
        <StackPanel Margin="0,0,4,0">

            <!-- 顶部标题 -->
            <StackPanel Margin="0,0,0,20">
                <TextBlock Text="驱动与激活"
                           FontSize="30"
                           FontWeight="Bold"
                           Foreground="#0F172A"/>

                <TextBlock Text="查看系统激活状态与当前驱动问题概览，后续再逐步扩展更深入的驱动治理能力。"
                           Margin="0,10,0,0"
                           FontSize="14"
                           Foreground="#64748B"/>
            </StackPanel>

            <!-- 顶部操作区 -->
            <Border Background="#F8FAFC"
                    BorderBrush="#CBD5E1"
                    BorderThickness="1"
                    CornerRadius="20"
                    Padding="18"
                    Margin="0,0,0,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="页面状态文本"
                               Grid.Column="0"
                               Text="正在读取系统状态..."
                               FontSize="13"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center"
                               Foreground="#64748B"/>

                    <Button Grid.Column="1"
                            Width="96"
                            Height="40"
                            Margin="12,0,0,0"
                            Content="刷新"
                            Click="刷新按钮_Click"
                            Background="White"
                            Foreground="#334155"
                            BorderBrush="#CBD5E1"/>

                    <Button Grid.Column="2"
                            Width="140"
                            Height="40"
                            Margin="12,0,0,0"
                            Content="打开激活设置"
                            Click="打开激活设置按钮_Click"
                            Background="#2563EB"
                            Foreground="White"
                            BorderThickness="0"/>

                    <Button Grid.Column="3"
                            Width="140"
                            Height="40"
                            Margin="12,0,0,0"
                            Content="打开设备管理器"
                            Click="打开设备管理器按钮_Click"
                            Background="#0F172A"
                            Foreground="White"
                            BorderThickness="0"/>
                </Grid>
            </Border>

            <!-- 激活状态展示 -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="240"/>
                    <ColumnDefinition Width="240"/>
                </Grid.ColumnDefinitions>

                <!-- 主状态卡 -->
                <Border x:Name="激活状态主卡"
                        Grid.Column="0"
                        Background="#F8FAFC"
                        BorderBrush="#E2E8F0"
                        BorderThickness="1"
                        CornerRadius="22"
                        Padding="22"
                        Margin="0,0,16,0">
                    <StackPanel>
                        <Border x:Name="激活状态标签边框"
                                Background="#E2E8F0"
                                CornerRadius="10"
                                Padding="10,4"
                                HorizontalAlignment="Left">
                            <TextBlock x:Name="激活状态标签文本"
                                       Text="状态"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="#334155"/>
                        </Border>

                        <TextBlock x:Name="激活状态标题文本"
                                   Margin="0,16,0,0"
                                   Text="系统激活状态"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   Foreground="#0F172A"/>

                        <TextBlock x:Name="激活状态说明文本"
                                   Margin="0,12,0,0"
                                   Text="这里显示系统激活状态说明。"
                                   FontSize="13"
                                   TextWrapping="Wrap"
                                   Foreground="#64748B"/>

                        <StackPanel Margin="0,18,0,0">
                            <TextBlock x:Name="授权名称文本"
                                       Text="授权名称"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       Foreground="#334155"/>
                            <TextBlock x:Name="部分密钥文本"
                                       Margin="0,6,0,0"
                                       Text="部分密钥"
                                       FontSize="12"
                                       Foreground="#64748B"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 右侧指标卡1 -->
                <Border Grid.Column="1"
                        Background="White"
                        BorderBrush="#E5E7EB"
                        BorderThickness="1"
                        CornerRadius="20"
                        Padding="18"
                        Margin="0,0,16,0">
                    <StackPanel>
                        <TextBlock Text="系统版本"
                                   FontSize="13"
                                   Foreground="#64748B"/>
                        <TextBlock x:Name="系统名称文本"
                                   Margin="0,12,0,0"
                                   Text="Windows"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   TextWrapping="Wrap"
                                   Foreground="#0F172A"/>
                        <TextBlock x:Name="系统版本文本"
                                   Margin="0,8,0,0"
                                   Text="版本"
                                   FontSize="12"
                                   Foreground="#64748B"/>
                    </StackPanel>
                </Border>

                <!-- 右侧指标卡2 -->
                <Border Grid.Column="2"
                        Background="White"
                        BorderBrush="#E5E7EB"
                        BorderThickness="1"
                        CornerRadius="20"
                        Padding="18">
                    <StackPanel>
                        <TextBlock Text="驱动问题"
                                   FontSize="13"
                                   Foreground="#64748B"/>
                        <TextBlock x:Name="驱动问题数量文本"
                                   Margin="0,12,0,0"
                                   Text="0"
                                   FontSize="36"
                                   FontWeight="Bold"
                                   Foreground="#0F172A"/>
                        <TextBlock x:Name="驱动问题说明文本"
                                   Margin="0,8,0,0"
                                   Text="当前未检测到异常设备。"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Foreground="#64748B"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 驱动问题列表 -->
            <Border Background="White"
                    BorderBrush="#E5E7EB"
                    BorderThickness="1"
                    CornerRadius="20"
                    Padding="18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="驱动问题明细"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="#0F172A"/>

                    <Grid Grid.Row="1" Margin="0,16,0,0">
                        <TextBlock x:Name="无问题文本"
                                   Text="当前未检测到异常设备。"
                                   Visibility="Collapsed"
                                   FontSize="13"
                                   Foreground="#64748B"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>

                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="驱动问题列表控件">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,12"
                                                Padding="14"
                                                CornerRadius="16"
                                                Background="#F8FAFC"
                                                BorderBrush="#E2E8F0"
                                                BorderThickness="1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{Binding 设备名称}"
                                                               FontSize="14"
                                                               FontWeight="Bold"
                                                               TextWrapping="Wrap"
                                                               Foreground="#0F172A"/>

                                                    <TextBlock Text="{Binding 错误说明}"
                                                               Margin="0,8,0,0"
                                                               FontSize="12"
                                                               TextWrapping="Wrap"
                                                               Foreground="#64748B"/>

                                                    <TextBlock Text="{Binding 设备Id}"
                                                               Margin="0,8,0,0"
                                                               FontSize="11"
                                                               TextWrapping="Wrap"
                                                               Foreground="#94A3B8"/>
                                                </StackPanel>

                                                <Border Grid.Column="1"
                                                        Background="#E2E8F0"
                                                        CornerRadius="10"
                                                        Padding="10,4"
                                                        Margin="12,0,0,0"
                                                        VerticalAlignment="Top">
                                                    <TextBlock Text="{Binding 错误代码文本}"
                                                               FontSize="12"
                                                               FontWeight="SemiBold"
                                                               Foreground="#334155"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>