<UserControl x:Class="Coingcola.视图层.电脑优化.优化体验视图"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="Transparent">

    <ScrollViewer x:Name="根滚动容器"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Background="Transparent"
                  PreviewMouseWheel="根滚动容器_PreviewMouseWheel">
        <StackPanel Margin="0,0,4,0">

            <!-- 标题 -->
            <StackPanel Margin="0,0,0,20">
                <TextBlock Text="一键优化"
                           FontSize="30"
                           FontWeight="Bold"
                           Foreground="#0F172A"/>

                <TextBlock Text="把设备状态、软件更新、常见修复和优化入口收拢到一个总控台，帮助你快速判断先做什么。"
                           Margin="0,10,0,0"
                           FontSize="14"
                           Foreground="#64748B"/>
            </StackPanel>

            <!-- 顶部状态 -->
            <Border Background="#F8FAFC"
                    BorderBrush="#CBD5E1"
                    BorderThickness="1"
                    CornerRadius="20"
                    Padding="18"
                    Margin="0,0,0,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="页面状态文本"
                               Grid.Column="0"
                               Text="正在读取体检总览..."
                               FontSize="13"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center"
                               Foreground="#64748B"/>

                    <Button Grid.Column="1"
                            Width="96"
                            Height="40"
                            Margin="12,0,0,0"
                            Content="刷新"
                            Click="刷新按钮_Click"
                            Background="White"
                            Foreground="#334155"
                            BorderBrush="#CBD5E1"/>
                </Grid>
            </Border>

            <!-- 主结论卡 -->
            <Border Background="#F8FAFC"
                    BorderBrush="#E2E8F0"
                    BorderThickness="1"
                    CornerRadius="24"
                    Padding="24"
                    Margin="0,0,0,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="280"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="体检结论"
                                   FontSize="13"
                                   Foreground="#64748B"/>

                        <TextBlock x:Name="页面结论文本"
                                   Margin="0,12,0,0"
                                   Text="页面结论"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   TextWrapping="Wrap"
                                   Foreground="#0F172A"/>

                        <TextBlock x:Name="副结论文本"
                                   Margin="0,14,0,0"
                                   Text="副结论"
                                   FontSize="14"
                                   TextWrapping="Wrap"
                                   Foreground="#475569"/>
                    </StackPanel>

                    <Border Grid.Column="1"
                            Background="White"
                            BorderBrush="#E5E7EB"
                            BorderThickness="1"
                            CornerRadius="20"
                            Padding="18"
                            Margin="20,0,0,0">
                        <StackPanel>
                            <TextBlock Text="当前设备"
                                       FontSize="13"
                                       Foreground="#64748B"/>

                            <TextBlock x:Name="设备名称文本"
                                       Margin="0,12,0,0"
                                       Text="设备名称"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       TextWrapping="Wrap"
                                       Foreground="#0F172A"/>

                            <TextBlock x:Name="系统名称文本"
                                       Margin="0,10,0,0"
                                       Text="系统名称"
                                       FontSize="13"
                                       TextWrapping="Wrap"
                                       Foreground="#64748B"/>

                            <TextBlock x:Name="当前用户文本"
                                       Margin="0,10,0,0"
                                       Text="当前用户"
                                       FontSize="13"
                                       TextWrapping="Wrap"
                                       Foreground="#64748B"/>

                            <TextBlock x:Name="权限状态文本"
                                       Margin="0,10,0,0"
                                       Text="权限状态"
                                       FontSize="13"
                                       TextWrapping="Wrap"
                                       Foreground="#64748B"/>

                            <TextBlock x:Name="Winget状态文本"
                                       Margin="0,10,0,0"
                                       Text="Winget 状态"
                                       FontSize="13"
                                       TextWrapping="Wrap"
                                       Foreground="#64748B"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- 摘要卡 -->
            <ItemsControl x:Name="摘要卡片列表"
                          Margin="0,0,0,20">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Width="240"
                                Margin="0,0,12,12"
                                Padding="16"
                                CornerRadius="18"
                                Background="White"
                                BorderBrush="#E5E7EB"
                                BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="{Binding 标题}"
                                           FontSize="13"
                                           Foreground="#64748B"/>
                                <TextBlock Text="{Binding 数值}"
                                           Margin="0,10,0,0"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           TextWrapping="Wrap"
                                           Foreground="#0F172A"/>
                                <TextBlock Text="{Binding 说明}"
                                           Margin="0,8,0,0"
                                           FontSize="11"
                                           TextWrapping="Wrap"
                                           Foreground="#94A3B8"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- 建议动作 -->
            <Border Background="White"
                    BorderBrush="#E5E7EB"
                    BorderThickness="1"
                    CornerRadius="20"
                    Padding="18"
                    Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="建议动作"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="#0F172A"/>

                    <TextBlock Text="当前版本先给出推荐入口，不直接做批量自动执行。"
                               Margin="0,8,0,0"
                               FontSize="12"
                               Foreground="#64748B"/>

                    <ItemsControl x:Name="建议列表控件"
                                  Margin="0,16,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#E2E8F0"
                                        BorderThickness="0,0,0,1"
                                        Padding="0,0,0,12"
                                        Margin="0,0,0,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="120"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel>
                                            <TextBlock Text="{Binding 标题}"
                                                       FontSize="15"
                                                       FontWeight="SemiBold"
                                                       Foreground="#0F172A"/>
                                            <TextBlock Text="{Binding 说明}"
                                                       Margin="0,8,0,0"
                                                       FontSize="12"
                                                       TextWrapping="Wrap"
                                                       Foreground="#64748B"/>
                                        </StackPanel>

                                        <Button Grid.Column="1"
                                                Height="38"
                                                Margin="12,0,0,0"
                                                Tag="{Binding 跳转标识}"
                                                Content="{Binding 按钮文本}"
                                                Click="建议动作按钮_Click"
                                                Background="#0F172A"
                                                Foreground="White"
                                                BorderThickness="0"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- 快速入口 -->
            <Border Background="White"
                    BorderBrush="#E5E7EB"
                    BorderThickness="1"
                    CornerRadius="20"
                    Padding="18">
                <StackPanel>
                    <TextBlock Text="快速入口"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="#0F172A"/>

                    <TextBlock Text="从总控台直接跳到已完成的关键页面。"
                               Margin="0,8,0,0"
                               FontSize="12"
                               Foreground="#64748B"/>

                    <ItemsControl x:Name="快捷入口列表控件"
                                  Margin="0,16,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="220"
                                        Margin="0,0,12,12"
                                        Padding="16"
                                        CornerRadius="18"
                                        Background="#F8FAFC"
                                        BorderBrush="#E2E8F0"
                                        BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="{Binding 名称}"
                                                   FontSize="15"
                                                   FontWeight="Bold"
                                                   Foreground="#0F172A"/>
                                        <TextBlock Text="{Binding 简介}"
                                                   Margin="0,8,0,0"
                                                   FontSize="12"
                                                   TextWrapping="Wrap"
                                                   Foreground="#64748B"/>
                                        <Button Height="36"
                                                Margin="0,14,0,0"
                                                Tag="{Binding 跳转标识}"
                                                Content="进入"
                                                Click="快捷入口按钮_Click"
                                                Background="White"
                                                Foreground="#334155"
                                                BorderBrush="#CBD5E1"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>