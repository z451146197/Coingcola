<UserControl x:Class="Coingcola.视图层.电脑优化.让电脑更顺手视图"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="Transparent"
             FocusVisualStyle="{x:Null}">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Background="Transparent"
                  Focusable="False">
        <StackPanel Margin="0,0,4,0">

            <Border Background="White"
                    BorderBrush="#E5E7EB"
                    BorderThickness="1"
                    CornerRadius="24"
                    Padding="20"
                    Margin="0,0,0,16">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="常用设置"
                                       FontSize="24"
                                       FontWeight="Bold"
                                       Foreground="#0F172A"/>

                            <TextBlock Margin="0,8,0,0"
                                       Text="先看状态，再做建议，最后执行动作。"
                                       FontSize="12"
                                       Foreground="#64748B"/>
                        </StackPanel>

                        <WrapPanel Grid.Column="1"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Top">
                            <Button Width="104"
                                    Height="34"
                                    Margin="0,0,10,0"
                                    Content="刷新状态"
                                    Click="刷新按钮_Click"
                                    Background="White"
                                    Foreground="#334155"
                                    BorderBrush="#CBD5E1"/>
                            <Button Width="132"
                                    Height="34"
                                    Margin="0,0,10,0"
                                    Content="一键建议处理"
                                    Click="一键建议处理按钮_Click"
                                    Background="#0F172A"
                                    Foreground="White"
                                    BorderThickness="0"/>
                            <Button Width="132"
                                    Height="34"
                                    Content="重启资源管理器"
                                    Click="重启资源管理器按钮_Click"
                                    Background="White"
                                    Foreground="#334155"
                                    BorderBrush="#CBD5E1"/>
                        </WrapPanel>
                    </Grid>

                    <Border Margin="0,14,0,0"
                            Background="#F8FAFC"
                            BorderBrush="#DBEAFE"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="14,12">
                        <TextBlock x:Name="总状态文本"
                                   FontSize="12"
                                   Foreground="#334155"
                                   TextWrapping="Wrap"/>
                    </Border>
                </StackPanel>
            </Border>

            <WrapPanel Margin="0,0,0,16">
                <Border Width="200"
                        Margin="0,0,14,14"
                        Padding="16"
                        Background="White"
                        BorderBrush="#E5E7EB"
                        BorderThickness="1"
                        CornerRadius="18">
                    <StackPanel>
                        <TextBlock Text="设置总数"
                                   FontSize="12"
                                   Foreground="#64748B"/>
                        <TextBlock x:Name="设置总数文本"
                                   Margin="0,8,0,0"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Foreground="#0F172A"/>
                    </StackPanel>
                </Border>

                <Border Width="200"
                        Margin="0,0,14,14"
                        Padding="16"
                        Background="White"
                        BorderBrush="#E5E7EB"
                        BorderThickness="1"
                        CornerRadius="18">
                    <StackPanel>
                        <TextBlock Text="已符合建议"
                                   FontSize="12"
                                   Foreground="#64748B"/>
                        <TextBlock x:Name="已符合文本"
                                   Margin="0,8,0,0"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Foreground="#0F172A"/>
                    </StackPanel>
                </Border>

                <Border Width="200"
                        Margin="0,0,14,14"
                        Padding="16"
                        Background="White"
                        BorderBrush="#E5E7EB"
                        BorderThickness="1"
                        CornerRadius="18">
                    <StackPanel>
                        <TextBlock Text="待处理"
                                   FontSize="12"
                                   Foreground="#64748B"/>
                        <TextBlock x:Name="待处理文本"
                                   Margin="0,8,0,0"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Foreground="#0F172A"/>
                    </StackPanel>
                </Border>

                <Border Width="200"
                        Margin="0,0,14,14"
                        Padding="16"
                        Background="White"
                        BorderBrush="#E5E7EB"
                        BorderThickness="1"
                        CornerRadius="18">
                    <StackPanel>
                        <TextBlock Text="需要重启资源管理器"
                                   FontSize="12"
                                   Foreground="#64748B"/>
                        <TextBlock x:Name="需重启文本"
                                   Margin="0,8,0,0"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Foreground="#0F172A"/>
                    </StackPanel>
                </Border>
            </WrapPanel>

            <Border Background="White"
                    BorderBrush="#E5E7EB"
                    BorderThickness="1"
                    CornerRadius="20"
                    Padding="18"
                    Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="建议优先处理"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="#0F172A"/>
                        <TextBlock Margin="0,8,0,0"
                                   Text="先处理不符合建议的高频项，再决定是否做细项切换。"
                                   FontSize="12"
                                   Foreground="#64748B"/>
                    </StackPanel>

                    <TextBlock x:Name="建议区状态文本"
                               Grid.Column="1"
                               FontSize="12"
                               VerticalAlignment="Top"
                               Foreground="#64748B"/>

                    <StackPanel Grid.ColumnSpan="2"
                                Margin="0,18,0,0">
                        <TextBlock x:Name="空建议文本"
                                   Visibility="Collapsed"
                                   Text="当前无需优先处理。"
                                   FontSize="13"
                                   Foreground="#64748B"/>

                        <ItemsControl x:Name="建议列表控件">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,12"
                                            Padding="16"
                                            Background="#F8FAFC"
                                            BorderBrush="#E2E8F0"
                                            BorderThickness="1"
                                            CornerRadius="16">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="130"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel>
                                                <TextBlock Text="{Binding 名称}"
                                                           FontSize="15"
                                                           FontWeight="Bold"
                                                           Foreground="#0F172A"/>

                                                <TextBlock Text="{Binding 说明}"
                                                           Margin="0,8,0,0"
                                                           FontSize="12"
                                                           Foreground="#64748B"
                                                           TextWrapping="Wrap"/>

                                                <TextBlock Text="{Binding 推荐说明}"
                                                           Margin="0,8,0,0"
                                                           FontSize="12"
                                                           Foreground="#334155"
                                                           TextWrapping="Wrap"/>
                                            </StackPanel>

                                            <Button Grid.Column="1"
                                                    Height="36"
                                                    Margin="12,0,0,0"
                                                    Tag="{Binding Id}"
                                                    Content="按建议处理"
                                                    Click="按建议处理按钮_Click"
                                                    Background="#0F172A"
                                                    Foreground="White"
                                                    BorderThickness="0"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Background="White"
                    BorderBrush="#E5E7EB"
                    BorderThickness="1"
                    CornerRadius="20"
                    Padding="18">
                <StackPanel>
                    <TextBlock Text="全部项目"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="#0F172A"/>

                    <ItemsControl x:Name="全部设置列表控件"
                                  Margin="0,16,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,14"
                                        Padding="16"
                                        Background="#F8FAFC"
                                        BorderBrush="#E2E8F0"
                                        BorderThickness="1"
                                        CornerRadius="16">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding 名称}"
                                                           FontSize="15"
                                                           FontWeight="Bold"
                                                           Foreground="#0F172A"/>
                                                <Border Margin="12,0,0,0"
                                                        Padding="8,2"
                                                        CornerRadius="10"
                                                        Background="#EEF2FF">
                                                    <TextBlock Text="{Binding 状态文本}"
                                                               FontSize="12"
                                                               Foreground="#4338CA"/>
                                                </Border>
                                                <TextBlock Margin="12,0,0,0"
                                                           Text="{Binding 推荐文本}"
                                                           FontSize="12"
                                                           VerticalAlignment="Center"
                                                           Foreground="#64748B"/>
                                            </StackPanel>
                                        </Grid>

                                        <TextBlock Grid.Row="1"
                                                   Margin="0,10,0,0"
                                                   Text="{Binding 说明}"
                                                   FontSize="12"
                                                   Foreground="#64748B"
                                                   TextWrapping="Wrap"/>

                                        <Grid Grid.Row="2" Margin="0,14,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="120"/>
                                                <ColumnDefinition Width="120"/>
                                            </Grid.ColumnDefinitions>

                                            <Border Background="White"
                                                    BorderBrush="#E2E8F0"
                                                    BorderThickness="1"
                                                    CornerRadius="10"
                                                    Padding="12,10"
                                                    Margin="0,0,12,0">
                                                <TextBlock Text="{Binding 推荐说明}"
                                                           FontSize="12"
                                                           Foreground="#334155"
                                                           TextWrapping="Wrap"/>
                                            </Border>

                                            <Button Grid.Column="1"
                                                    Height="38"
                                                    Margin="0,0,12,0"
                                                    Tag="{Binding Id}"
                                                    Content="按建议处理"
                                                    Click="按建议处理按钮_Click"
                                                    Background="#0F172A"
                                                    Foreground="White"
                                                    BorderThickness="0"/>

                                            <Button Grid.Column="2"
                                                    Height="38"
                                                    Tag="{Binding Id}"
                                                    Content="手动切换"
                                                    Click="手动切换按钮_Click"
                                                    Background="White"
                                                    Foreground="#334155"
                                                    BorderBrush="#CBD5E1"/>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
