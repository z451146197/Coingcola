<UserControl x:Class="Coingcola.视图层.此电脑.看看这台电脑视图"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="Transparent">

    <ScrollViewer x:Name="根滚动容器"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Background="Transparent"
                  PreviewMouseWheel="根滚动容器_PreviewMouseWheel">
        <StackPanel Margin="0,0,4,0">

            <!-- 标题 -->
            <StackPanel Margin="0,0,0,20">
                <TextBlock Text="电脑概览"
                           FontSize="30"
                           FontWeight="Bold"
                           Foreground="#0F172A"/>

                <TextBlock Text="快速查看当前电脑的系统概览、关键硬件和基础运行信息。"
                           Margin="0,10,0,0"
                           FontSize="14"
                           Foreground="#64748B"/>
            </StackPanel>

            <!-- 顶部状态 -->
            <Border Background="#F8FAFC"
                    BorderBrush="#CBD5E1"
                    BorderThickness="1"
                    CornerRadius="20"
                    Padding="18"
                    Margin="0,0,0,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="页面状态文本"
                               Grid.Column="0"
                               Text="正在读取这台电脑的概览信息..."
                               FontSize="13"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center"
                               Foreground="#64748B"/>

                    <Button Grid.Column="1"
                            Width="96"
                            Height="40"
                            Margin="12,0,0,0"
                            Content="刷新"
                            Click="刷新按钮_Click"
                            Background="White"
                            Foreground="#334155"
                            BorderBrush="#CBD5E1"/>
                </Grid>
            </Border>

            <!-- 设备主卡 -->
            <Border x:Name="设备主卡"
                    Background="#F8FAFC"
                    BorderBrush="#E2E8F0"
                    BorderThickness="1"
                    CornerRadius="24"
                    Padding="24"
                    Margin="0,0,0,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="260"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="当前设备"
                                   FontSize="13"
                                   Foreground="#64748B"/>

                        <TextBlock x:Name="设备名称文本"
                                   Margin="0,10,0,0"
                                   Text="设备名称"
                                   FontSize="30"
                                   FontWeight="Bold"
                                   Foreground="#0F172A"/>

                        <TextBlock x:Name="系统名称文本"
                                   Margin="0,14,0,0"
                                   Text="系统名称"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="#334155"/>

                        <TextBlock x:Name="系统版本文本"
                                   Margin="0,6,0,0"
                                   Text="系统版本"
                                   FontSize="13"
                                   Foreground="#64748B"/>

                        <TextBlock x:Name="运行结论文本"
                                   Margin="0,16,0,0"
                                   Text="运行结论"
                                   FontSize="13"
                                   TextWrapping="Wrap"
                                   Foreground="#475569"/>
                    </StackPanel>

                    <Border Grid.Column="1"
                            Background="White"
                            BorderBrush="#E5E7EB"
                            BorderThickness="1"
                            CornerRadius="20"
                            Padding="18"
                            Margin="20,0,0,0">
                        <StackPanel>
                            <TextBlock Text="当前会话"
                                       FontSize="13"
                                       Foreground="#64748B"/>

                            <TextBlock x:Name="当前用户文本"
                                       Margin="0,12,0,0"
                                       Text="当前用户"
                                       FontSize="17"
                                       FontWeight="Bold"
                                       TextWrapping="Wrap"
                                       Foreground="#0F172A"/>

                            <TextBlock x:Name="权限状态文本"
                                       Margin="0,10,0,0"
                                       Text="权限状态"
                                       FontSize="13"
                                       Foreground="#64748B"/>

                            <TextBlock x:Name="运行时长文本"
                                       Margin="0,10,0,0"
                                       Text="运行时长"
                                       FontSize="13"
                                       Foreground="#64748B"/>

                            <TextBlock x:Name="上次启动时间文本"
                                       Margin="0,10,0,0"
                                       Text="上次启动时间"
                                       FontSize="13"
                                       TextWrapping="Wrap"
                                       Foreground="#64748B"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- 关键指标卡 -->
            <ItemsControl x:Name="关键指标卡列表"
                          Margin="0,0,0,20">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Width="250"
                                Margin="0,0,12,12"
                                Padding="16"
                                CornerRadius="18"
                                Background="White"
                                BorderBrush="#E5E7EB"
                                BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="{Binding 标题}"
                                           FontSize="13"
                                           Foreground="#64748B"/>
                                <TextBlock Text="{Binding 数值}"
                                           Margin="0,10,0,0"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           TextWrapping="Wrap"
                                           Foreground="#0F172A"/>
                                <TextBlock Text="{Binding 说明}"
                                           Margin="0,8,0,0"
                                           FontSize="11"
                                           TextWrapping="Wrap"
                                           Foreground="#94A3B8"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- 详细信息 -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 左侧 -->
                <Border Grid.Column="0"
                        Background="White"
                        BorderBrush="#E5E7EB"
                        BorderThickness="1"
                        CornerRadius="20"
                        Padding="18"
                        Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="系统信息"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="#0F172A"/>

                        <StackPanel Margin="0,16,0,0">
                            <TextBlock Text="系统名称"
                                       FontSize="12"
                                       Foreground="#64748B"/>
                            <TextBlock x:Name="系统信息名称文本"
                                       Margin="0,6,0,0"
                                       Text="系统名称"
                                       FontSize="14"
                                       TextWrapping="Wrap"
                                       Foreground="#0F172A"/>
                        </StackPanel>

                        <StackPanel Margin="0,14,0,0">
                            <TextBlock Text="系统版本"
                                       FontSize="12"
                                       Foreground="#64748B"/>
                            <TextBlock x:Name="系统信息版本文本"
                                       Margin="0,6,0,0"
                                       Text="系统版本"
                                       FontSize="14"
                                       TextWrapping="Wrap"
                                       Foreground="#0F172A"/>
                        </StackPanel>

                        <StackPanel Margin="0,14,0,0">
                            <TextBlock Text="系统类型"
                                       FontSize="12"
                                       Foreground="#64748B"/>
                            <TextBlock x:Name="系统类型文本"
                                       Margin="0,6,0,0"
                                       Text="系统类型"
                                       FontSize="14"
                                       TextWrapping="Wrap"
                                       Foreground="#0F172A"/>
                        </StackPanel>

                        <StackPanel Margin="0,14,0,0">
                            <TextBlock Text="设备厂商"
                                       FontSize="12"
                                       Foreground="#64748B"/>
                            <TextBlock x:Name="设备厂商文本"
                                       Margin="0,6,0,0"
                                       Text="设备厂商"
                                       FontSize="14"
                                       TextWrapping="Wrap"
                                       Foreground="#0F172A"/>
                        </StackPanel>

                        <StackPanel Margin="0,14,0,0">
                            <TextBlock Text="设备型号"
                                       FontSize="12"
                                       Foreground="#64748B"/>
                            <TextBlock x:Name="设备型号文本"
                                       Margin="0,6,0,0"
                                       Text="设备型号"
                                       FontSize="14"
                                       TextWrapping="Wrap"
                                       Foreground="#0F172A"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 右侧 -->
                <Border Grid.Column="1"
                        Background="White"
                        BorderBrush="#E5E7EB"
                        BorderThickness="1"
                        CornerRadius="20"
                        Padding="18"
                        Margin="10,0,0,0">
                    <StackPanel>
                        <TextBlock Text="硬件信息"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="#0F172A"/>

                        <StackPanel Margin="0,16,0,0">
                            <TextBlock Text="主板"
                                       FontSize="12"
                                       Foreground="#64748B"/>
                            <TextBlock x:Name="主板信息文本"
                                       Margin="0,6,0,0"
                                       Text="主板信息"
                                       FontSize="14"
                                       TextWrapping="Wrap"
                                       Foreground="#0F172A"/>
                        </StackPanel>

                        <StackPanel Margin="0,14,0,0">
                            <TextBlock Text="BIOS"
                                       FontSize="12"
                                       Foreground="#64748B"/>
                            <TextBlock x:Name="BIOS信息文本"
                                       Margin="0,6,0,0"
                                       Text="BIOS信息"
                                       FontSize="14"
                                       TextWrapping="Wrap"
                                       Foreground="#0F172A"/>
                        </StackPanel>

                        <StackPanel Margin="0,14,0,0">
                            <TextBlock Text="CPU"
                                       FontSize="12"
                                       Foreground="#64748B"/>
                            <TextBlock x:Name="CPU信息文本"
                                       Margin="0,6,0,0"
                                       Text="CPU"
                                       FontSize="14"
                                       TextWrapping="Wrap"
                                       Foreground="#0F172A"/>
                        </StackPanel>

                        <StackPanel Margin="0,14,0,0">
                            <TextBlock Text="显卡"
                                       FontSize="12"
                                       Foreground="#64748B"/>
                            <TextBlock x:Name="显卡信息文本"
                                       Margin="0,6,0,0"
                                       Text="显卡"
                                       FontSize="14"
                                       TextWrapping="Wrap"
                                       Foreground="#0F172A"/>
                        </StackPanel>

                        <StackPanel Margin="0,14,0,0">
                            <TextBlock Text="系统盘"
                                       FontSize="12"
                                       Foreground="#64748B"/>
                            <TextBlock x:Name="系统盘信息文本"
                                       Margin="0,6,0,0"
                                       Text="系统盘"
                                       FontSize="14"
                                       TextWrapping="Wrap"
                                       Foreground="#0F172A"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</UserControl>