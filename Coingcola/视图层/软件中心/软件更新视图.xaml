<UserControl x:Class="Coingcola.视图层.软件中心.软件更新视图"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="Transparent">

    <ScrollViewer x:Name="根滚动容器"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Background="Transparent"
                  PreviewMouseWheel="根滚动容器_PreviewMouseWheel">
        <StackPanel Margin="0,0,4,0">

            <!-- 标题 -->
            <StackPanel Margin="0,0,0,20">
                <TextBlock Text="软件更新"
                           FontSize="30"
                           FontWeight="Bold"
                           Foreground="#0F172A"/>

                <TextBlock Text="优先处理高频软件的更新入口。系统支持时可直接发起更新，不支持时自动降级为官网更新。"
                           Margin="0,10,0,0"
                           FontSize="14"
                           Foreground="#64748B"/>
            </StackPanel>

            <!-- 顶部状态 -->
            <Border Background="#F8FAFC"
                    BorderBrush="#CBD5E1"
                    BorderThickness="1"
                    CornerRadius="20"
                    Padding="18"
                    Margin="0,0,0,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="页面状态文本"
                               Grid.Column="0"
                               Text="正在加载软件更新页..."
                               FontSize="13"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center"
                               Foreground="#64748B"/>

                    <Button Grid.Column="1"
                            Width="110"
                            Height="40"
                            Margin="12,0,0,0"
                            Content="全部系统更新"
                            Click="全部系统更新按钮_Click"
                            Background="#2563EB"
                            Foreground="White"
                            BorderThickness="0"/>

                    <Button Grid.Column="2"
                            Width="96"
                            Height="40"
                            Margin="12,0,0,0"
                            Content="刷新"
                            Click="刷新按钮_Click"
                            Background="White"
                            Foreground="#334155"
                            BorderBrush="#CBD5E1"/>
                </Grid>
            </Border>

            <!-- 摘要 -->
            <ItemsControl x:Name="摘要卡片列表"
                          Margin="0,0,0,20">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Width="220"
                                Margin="0,0,12,12"
                                Padding="16"
                                CornerRadius="18"
                                Background="White"
                                BorderBrush="#E5E7EB"
                                BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="{Binding 标题}"
                                           FontSize="13"
                                           Foreground="#64748B"/>
                                <TextBlock Text="{Binding 数值}"
                                           Margin="0,10,0,0"
                                           FontSize="26"
                                           FontWeight="Bold"
                                           Foreground="#0F172A"/>
                                <TextBlock Text="{Binding 说明}"
                                           Margin="0,8,0,0"
                                           FontSize="11"
                                           TextWrapping="Wrap"
                                           Foreground="#94A3B8"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- 搜索与分类 -->
            <Border Background="White"
                    BorderBrush="#E5E7EB"
                    BorderThickness="1"
                    CornerRadius="20"
                    Padding="18"
                    Margin="0,0,0,20">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="搜索输入框"
                                 Grid.Column="0"
                                 Height="40"
                                 Padding="12,8"
                                 FontSize="14"
                                 VerticalContentAlignment="Center"
                                 KeyDown="搜索输入框_KeyDown"/>

                        <Button Grid.Column="1"
                                Width="88"
                                Height="40"
                                Margin="12,0,0,0"
                                Content="检索"
                                Click="检索按钮_Click"
                                Background="#0F172A"
                                Foreground="White"
                                BorderThickness="0"/>

                        <Button Grid.Column="2"
                                Width="88"
                                Height="40"
                                Margin="12,0,0,0"
                                Content="重置"
                                Click="重置按钮_Click"
                                Background="White"
                                Foreground="#334155"
                                BorderBrush="#CBD5E1"/>
                    </Grid>

                    <WrapPanel Margin="0,14,0,0">
                        <Button x:Name="全部分类按钮"
                                Content="全部"
                                Width="72"
                                Height="34"
                                Margin="0,0,10,10"
                                Click="全部分类按钮_Click"/>
                        <Button x:Name="浏览器分类按钮"
                                Content="浏览器"
                                Width="72"
                                Height="34"
                                Margin="0,0,10,10"
                                Click="浏览器分类按钮_Click"/>
                        <Button x:Name="办公分类按钮"
                                Content="办公"
                                Width="72"
                                Height="34"
                                Margin="0,0,10,10"
                                Click="办公分类按钮_Click"/>
                        <Button x:Name="通讯分类按钮"
                                Content="通讯"
                                Width="72"
                                Height="34"
                                Margin="0,0,10,10"
                                Click="通讯分类按钮_Click"/>
                        <Button x:Name="工具分类按钮"
                                Content="工具"
                                Width="72"
                                Height="34"
                                Margin="0,0,10,10"
                                Click="工具分类按钮_Click"/>
                        <Button x:Name="压缩分类按钮"
                                Content="压缩"
                                Width="72"
                                Height="34"
                                Margin="0,0,10,10"
                                Click="压缩分类按钮_Click"/>
                        <Button x:Name="开发分类按钮"
                                Content="开发"
                                Width="72"
                                Height="34"
                                Margin="0,0,10,10"
                                Click="开发分类按钮_Click"/>
                        <Button x:Name="播放器分类按钮"
                                Content="播放器"
                                Width="72"
                                Height="34"
                                Margin="0,0,10,10"
                                Click="播放器分类按钮_Click"/>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- 更新列表 -->
            <Border Background="White"
                    BorderBrush="#E5E7EB"
                    BorderThickness="1"
                    CornerRadius="20"
                    Padding="18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="更新入口"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="#0F172A"/>

                        <TextBlock x:Name="结果数量文本"
                                   Grid.Column="1"
                                   Text="共 0 项"
                                   FontSize="12"
                                   VerticalAlignment="Center"
                                   Foreground="#64748B"/>
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,16,0,0">
                        <TextBlock x:Name="空结果文本"
                                   Text="未命中对应软件。"
                                   Visibility="Collapsed"
                                   FontSize="13"
                                   Foreground="#64748B"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>

                        <ItemsControl x:Name="更新列表控件"
                                      PreviewMouseWheel="更新列表控件_PreviewMouseWheel">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>

                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="360"
                                            Margin="0,0,16,16"
                                            Padding="18"
                                            CornerRadius="20"
                                            Background="#F8FAFC"
                                            BorderBrush="#E2E8F0"
                                            BorderThickness="1">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <Grid Grid.Row="0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Text="{Binding 名称}"
                                                           FontSize="17"
                                                           FontWeight="Bold"
                                                           Foreground="#0F172A"
                                                           TextWrapping="Wrap"/>

                                                <Border Grid.Column="1"
                                                        Background="#E2E8F0"
                                                        CornerRadius="10"
                                                        Padding="10,4"
                                                        Margin="12,0,0,0"
                                                        VerticalAlignment="Top">
                                                    <TextBlock Text="{Binding 分类}"
                                                               FontSize="12"
                                                               FontWeight="SemiBold"
                                                               Foreground="#334155"/>
                                                </Border>

                                                <Border Grid.Column="2"
                                                        Background="#DBEAFE"
                                                        CornerRadius="10"
                                                        Padding="10,4"
                                                        Margin="10,0,0,0"
                                                        VerticalAlignment="Top">
                                                    <TextBlock Text="{Binding 更新方式}"
                                                               FontSize="12"
                                                               FontWeight="SemiBold"
                                                               Foreground="#1D4ED8"/>
                                                </Border>
                                            </Grid>

                                            <TextBlock Grid.Row="1"
                                                       Text="{Binding 说明}"
                                                       Margin="0,12,0,0"
                                                       FontSize="12"
                                                       TextWrapping="Wrap"
                                                       Foreground="#64748B"/>

                                            <TextBlock Grid.Row="2"
                                                       Text="{Binding 风险级别}"
                                                       Margin="0,14,0,0"
                                                       FontSize="11"
                                                       TextWrapping="Wrap"
                                                       Foreground="#94A3B8"/>

                                            <Button Grid.Row="3"
                                                    Height="40"
                                                    Margin="0,16,0,0"
                                                    Tag="{Binding Id}"
                                                    Content="{Binding 按钮文本}"
                                                    Click="执行按钮_Click"
                                                    Background="#0F172A"
                                                    Foreground="White"
                                                    BorderThickness="0"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Grid>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>