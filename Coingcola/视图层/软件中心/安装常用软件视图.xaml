<UserControl x:Class="Coingcola.视图层.软件中心.安装常用软件视图"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="Transparent"
             FocusVisualStyle="{x:Null}">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Background="Transparent"
                  Focusable="False">
        <StackPanel Margin="0,0,4,0">

            <Border Background="White"
                    BorderBrush="#E5E7EB"
                    BorderThickness="1"
                    CornerRadius="24"
                    Padding="20"
                    Margin="0,0,0,16">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="安装常用软件"
                                       FontSize="24"
                                       FontWeight="Bold"
                                       Foreground="#0F172A"/>
                            <TextBlock Margin="0,8,0,0"
                                       Text="优先处理高频软件安装，支持系统安装与官网两种路径。"
                                       FontSize="12"
                                       Foreground="#64748B"/>
                        </StackPanel>

                        <WrapPanel Grid.Column="1"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Top">
                            <Button Width="72"
                                    Height="34"
                                    Margin="0,0,10,0"
                                    Content="刷新"
                                    Click="刷新按钮_Click"
                                    Background="White"
                                    Foreground="#334155"
                                    BorderBrush="#CBD5E1"/>
                            <Button Width="72"
                                    Height="34"
                                    Content="重置"
                                    Click="重置按钮_Click"
                                    Background="White"
                                    Foreground="#334155"
                                    BorderBrush="#CBD5E1"/>
                        </WrapPanel>
                    </Grid>

                    <Border Margin="0,14,0,0"
                            Background="#F8FAFC"
                            BorderBrush="#DBEAFE"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="14,12">
                        <TextBlock x:Name="状态文本"
                                   FontSize="12"
                                   Foreground="#334155"
                                   TextWrapping="Wrap"/>
                    </Border>

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="96"/>
                            <ColumnDefinition Width="96"/>
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="搜索输入框"
                                 Grid.Column="0"
                                 Height="42"
                                 Padding="12,8"
                                 FontSize="14"
                                 VerticalContentAlignment="Center"
                                 KeyDown="搜索输入框_KeyDown"/>

                        <Button Grid.Column="1"
                                Height="42"
                                Margin="12,0,0,0"
                                Content="搜索"
                                Click="搜索按钮_Click"
                                Background="#0F172A"
                                Foreground="White"
                                BorderThickness="0"/>

                        <Button Grid.Column="2"
                                Height="42"
                                Margin="12,0,0,0"
                                Content="清空"
                                Click="清空按钮_Click"
                                Background="White"
                                Foreground="#334155"
                                BorderBrush="#CBD5E1"/>
                    </Grid>

                    <WrapPanel Margin="0,14,0,0">
                        <Button x:Name="全部按钮"
                                Width="56"
                                Height="32"
                                Margin="0,0,10,10"
                                Content="全部"
                                Tag="全部"
                                Click="分类按钮_Click"/>
                        <Button x:Name="浏览器按钮"
                                Width="72"
                                Height="32"
                                Margin="0,0,10,10"
                                Content="浏览器"
                                Tag="浏览器"
                                Click="分类按钮_Click"/>
                        <Button x:Name="办公按钮"
                                Width="56"
                                Height="32"
                                Margin="0,0,10,10"
                                Content="办公"
                                Tag="办公"
                                Click="分类按钮_Click"/>
                        <Button x:Name="通讯按钮"
                                Width="56"
                                Height="32"
                                Margin="0,0,10,10"
                                Content="通讯"
                                Tag="通讯"
                                Click="分类按钮_Click"/>
                        <Button x:Name="工具按钮"
                                Width="56"
                                Height="32"
                                Margin="0,0,10,10"
                                Content="工具"
                                Tag="工具"
                                Click="分类按钮_Click"/>
                        <Button x:Name="压缩按钮"
                                Width="56"
                                Height="32"
                                Margin="0,0,10,10"
                                Content="压缩"
                                Tag="压缩"
                                Click="分类按钮_Click"/>
                        <Button x:Name="开发按钮"
                                Width="56"
                                Height="32"
                                Margin="0,0,10,10"
                                Content="开发"
                                Tag="开发"
                                Click="分类按钮_Click"/>
                        <Button x:Name="播放器按钮"
                                Width="72"
                                Height="32"
                                Margin="0,0,10,10"
                                Content="播放器"
                                Tag="播放器"
                                Click="分类按钮_Click"/>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <WrapPanel Margin="0,0,0,16">
                <Border Width="200"
                        Margin="0,0,14,14"
                        Padding="16"
                        Background="White"
                        BorderBrush="#E5E7EB"
                        BorderThickness="1"
                        CornerRadius="18">
                    <StackPanel>
                        <TextBlock Text="软件总数"
                                   FontSize="12"
                                   Foreground="#64748B"/>
                        <TextBlock x:Name="软件总数文本"
                                   Margin="0,8,0,0"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Foreground="#0F172A"/>
                    </StackPanel>
                </Border>

                <Border Width="200"
                        Margin="0,0,14,14"
                        Padding="16"
                        Background="White"
                        BorderBrush="#E5E7EB"
                        BorderThickness="1"
                        CornerRadius="18">
                    <StackPanel>
                        <TextBlock Text="支持系统安装"
                                   FontSize="12"
                                   Foreground="#64748B"/>
                        <TextBlock x:Name="支持系统安装文本"
                                   Margin="0,8,0,0"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Foreground="#0F172A"/>
                    </StackPanel>
                </Border>

                <Border Width="200"
                        Margin="0,0,14,14"
                        Padding="16"
                        Background="White"
                        BorderBrush="#E5E7EB"
                        BorderThickness="1"
                        CornerRadius="18">
                    <StackPanel>
                        <TextBlock Text="官网安装"
                                   FontSize="12"
                                   Foreground="#64748B"/>
                        <TextBlock x:Name="官网安装文本"
                                   Margin="0,8,0,0"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Foreground="#0F172A"/>
                    </StackPanel>
                </Border>

                <Border Width="200"
                        Margin="0,0,14,14"
                        Padding="16"
                        Background="White"
                        BorderBrush="#E5E7EB"
                        BorderThickness="1"
                        CornerRadius="18">
                    <StackPanel>
                        <TextBlock Text="当前命中"
                                   FontSize="12"
                                   Foreground="#64748B"/>
                        <TextBlock x:Name="当前命中文本"
                                   Margin="0,8,0,0"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Foreground="#0F172A"/>
                    </StackPanel>
                </Border>
            </WrapPanel>

            <Border Background="White"
                    BorderBrush="#E5E7EB"
                    BorderThickness="1"
                    CornerRadius="20"
                    Padding="18"
                    Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="建议优先安装"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="#0F172A"/>

                    <TextBlock Margin="0,8,0,0"
                               Text="先把最常用的办公、通讯、浏览器和基础工具装起来。"
                               FontSize="12"
                               Foreground="#64748B"/>

                    <TextBlock x:Name="推荐区空状态文本"
                               Margin="0,16,0,0"
                               Visibility="Collapsed"
                               Text="当前筛选条件下没有推荐项。"
                               FontSize="13"
                               Foreground="#64748B"/>

                    <ItemsControl x:Name="推荐软件列表控件"
                                  Margin="0,16,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="250"
                                        Margin="0,0,14,14"
                                        Padding="16"
                                        Background="#F8FAFC"
                                        BorderBrush="#E2E8F0"
                                        BorderThickness="1"
                                        CornerRadius="16">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding 名称}"
                                                       FontSize="15"
                                                       FontWeight="Bold"
                                                       Foreground="#0F172A"/>
                                            <Border Margin="10,0,0,0"
                                                    Padding="8,2"
                                                    CornerRadius="10"
                                                    Background="#EEF2FF">
                                                <TextBlock Text="{Binding 分类}"
                                                           FontSize="12"
                                                           Foreground="#4338CA"/>
                                            </Border>
                                        </StackPanel>

                                        <TextBlock Text="{Binding 说明}"
                                                   Margin="0,8,0,0"
                                                   FontSize="12"
                                                   Foreground="#64748B"
                                                   TextWrapping="Wrap"/>

                                        <Button Height="36"
                                                Margin="0,14,0,0"
                                                Tag="{Binding Id}"
                                                Content="{Binding 动作文案}"
                                                Click="执行软件动作按钮_Click"
                                                Background="#0F172A"
                                                Foreground="White"
                                                BorderThickness="0"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Background="White"
                    BorderBrush="#E5E7EB"
                    BorderThickness="1"
                    CornerRadius="20"
                    Padding="18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="全部软件"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="#0F172A"/>

                        <TextBlock x:Name="结果总数文本"
                                   Grid.Column="1"
                                   FontSize="12"
                                   VerticalAlignment="Center"
                                   Foreground="#64748B"/>
                    </Grid>

                    <StackPanel Grid.Row="1" Margin="0,16,0,0">
                        <TextBlock x:Name="空结果文本"
                                   Visibility="Collapsed"
                                   Text="当前条件下没有可显示的软件。"
                                   FontSize="13"
                                   Foreground="#64748B"/>

                        <ItemsControl x:Name="全部软件列表控件">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,12"
                                            Padding="16"
                                            Background="#F8FAFC"
                                            BorderBrush="#E2E8F0"
                                            BorderThickness="1"
                                            CornerRadius="16">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="120"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding 名称}"
                                                               FontSize="15"
                                                               FontWeight="Bold"
                                                               Foreground="#0F172A"/>
                                                    <Border Margin="10,0,0,0"
                                                            Padding="8,2"
                                                            CornerRadius="10"
                                                            Background="#EEF2FF">
                                                        <TextBlock Text="{Binding 分类}"
                                                                   FontSize="12"
                                                                   Foreground="#4338CA"/>
                                                    </Border>
                                                    <TextBlock Margin="10,0,0,0"
                                                               VerticalAlignment="Center"
                                                               Text="{Binding 来源类型}"
                                                               FontSize="12"
                                                               Foreground="#64748B"/>
                                                </StackPanel>

                                                <TextBlock Text="{Binding 说明}"
                                                           Margin="0,8,0,0"
                                                           FontSize="12"
                                                           Foreground="#64748B"
                                                           TextWrapping="Wrap"/>
                                            </StackPanel>

                                            <Button Grid.Column="1"
                                                    Height="38"
                                                    Margin="14,0,0,0"
                                                    Tag="{Binding Id}"
                                                    Content="{Binding 动作文案}"
                                                    Click="执行软件动作按钮_Click"
                                                    Background="#0F172A"
                                                    Foreground="White"
                                                    BorderThickness="0"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Grid>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
