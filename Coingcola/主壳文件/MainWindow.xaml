<Window x:Class="Coingcola.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Coingcola助手"
        Width="1480"
        Height="900"
        MinWidth="1180"
        MinHeight="720"
        WindowStartupLocation="CenterScreen"
        Background="#F3F4F6">

    <Grid Background="#F3F4F6">
        <Grid Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="460"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧：一级菜单 + 功能分区 -->
            <Border Grid.Column="0"
                    Background="White"
                    CornerRadius="24"
                    BorderBrush="#E5E7EB"
                    BorderThickness="1"
                    Margin="0,0,20,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- 一级菜单 -->
                    <Border Grid.Column="0"
                            BorderBrush="#E5E7EB"
                            BorderThickness="0,0,1,0"
                            Background="White"
                            CornerRadius="24,0,0,24">
                        <Grid Margin="16">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Margin="6,4,6,18">
                                <TextBlock Text="Coingcola助手"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           Foreground="#0F172A"/>
                                <TextBlock Text="Windows 主机治理工作台"
                                           Margin="0,6,0,0"
                                           FontSize="12"
                                           Foreground="#64748B"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1">
                                <Button x:Name="开始使用按钮"
                                        Content="开始使用"
                                        Height="44"
                                        Margin="0,0,0,12"
                                        Click="开始使用按钮_Click"
                                        FontSize="15"
                                        FontWeight="SemiBold"/>

                                <Button x:Name="此电脑按钮"
                                        Content="我的电脑"
                                        Height="44"
                                        Margin="0,0,0,12"
                                        Click="此电脑按钮_Click"
                                        FontSize="15"
                                        FontWeight="SemiBold"/>

                                <Button x:Name="电脑优化按钮"
                                        Content="电脑优化"
                                        Height="44"
                                        Margin="0,0,0,12"
                                        Click="电脑优化按钮_Click"
                                        FontSize="15"
                                        FontWeight="SemiBold"/>

                                <Button x:Name="软件中心按钮"
                                        Content="软件中心"
                                        Height="44"
                                        Margin="0,0,0,12"
                                        Click="软件中心按钮_Click"
                                        FontSize="15"
                                        FontWeight="SemiBold"/>

                                <Button x:Name="关于按钮"
                                        Content="关于"
                                        Height="44"
                                        Click="关于按钮_Click"
                                        FontSize="15"
                                        FontWeight="SemiBold"/>
                            </StackPanel>

                            <StackPanel Grid.Row="2" Margin="6,12,6,4">
                                <TextBlock x:Name="状态文本"
                                           Text="状态：就绪"
                                           FontSize="12"
                                           Foreground="#64748B"/>
                                <TextBlock x:Name="权限文本"
                                           Text="权限：检测中..."
                                           Margin="0,4,0,0"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="#64748B"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 功能分区 -->
                    <Border Grid.Column="1"
                            Background="White"
                            CornerRadius="0,24,24,0">
                        <Grid Margin="16">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Margin="6,4,6,18">
                                <TextBlock Text="功能分区"
                                           FontSize="15"
                                           FontWeight="Bold"
                                           Foreground="#0F172A"/>
                                <TextBlock x:Name="模块简介文本"
                                           Text="当前一级菜单简介"
                                           Margin="0,8,0,0"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           Foreground="#64748B"/>
                            </StackPanel>

                            <StackPanel x:Name="功能分区按钮容器"
                                        Grid.Row="1"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- 右侧内容区 -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 功能指引 -->
                <Border x:Name="功能指引卡片"
                        Grid.Row="0"
                        Background="White"
                        CornerRadius="24"
                        BorderBrush="#E5E7EB"
                        BorderThickness="1"
                        Padding="22"
                        Margin="0,0,0,20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="220"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock x:Name="功能指引标题文本"
                                       Text="功能指引"
                                       FontSize="20"
                                       FontWeight="Bold"
                                       Foreground="#0F172A"/>
                            <TextBlock x:Name="功能指引内容文本"
                                       Text="这里显示当前功能的使用说明。"
                                       Margin="0,10,0,0"
                                       FontSize="13"
                                       TextWrapping="Wrap"
                                       Foreground="#64748B"/>
                        </StackPanel>

                        <Border Grid.Column="1"
                                Background="#F8FAFC"
                                BorderBrush="#E2E8F0"
                                BorderThickness="1"
                                CornerRadius="18"
                                Padding="14"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top">
                            <StackPanel>
                                <TextBlock Text="当前状态"
                                           FontSize="12"
                                           Foreground="#64748B"/>
                                <TextBlock x:Name="当前状态文本"
                                           Text="等待选择"
                                           Margin="0,6,0,0"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap"
                                           Foreground="#0F172A"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- 主内容容器 -->
                <Border x:Name="主内容边框"
          Grid.Row="1"
          Background="White"
          CornerRadius="24"
          BorderBrush="#E5E7EB"
          BorderThickness="1"
          Padding="24">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock x:Name="页面标题文本"
                                   Grid.Row="0"
                                   Text="页面标题"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   Foreground="#0F172A"/>

                        <TextBlock x:Name="页面简介文本"
                                   Grid.Row="1"
                                   Text="这里显示当前页面的功能简介。"
                                   Margin="0,12,0,0"
                                   FontSize="14"
                                   TextWrapping="Wrap"
                                   Foreground="#64748B"/>

                        <Grid x:Name="页面内容区容器"
        Grid.Row="2"
        Margin="0,24,0,0">
  <ContentControl x:Name="页面内容容器"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch"
                  HorizontalContentAlignment="Stretch"
                  VerticalContentAlignment="Stretch"
                  Visibility="Collapsed"/>

                            <Border x:Name="占位内容边框"
                                    Background="#F8FAFC"
                                    BorderBrush="#CBD5E1"
                                    BorderThickness="1"
                                    CornerRadius="20"
                                    Padding="24"
                                    Visibility="Visible">
                                <StackPanel>
                                    <TextBlock Text="内容区占位"
                                               FontSize="20"
                                               FontWeight="Bold"
                                               Foreground="#0F172A"/>

                                    <TextBlock x:Name="内容占位说明文本"
                                               Margin="0,12,0,0"
                                               Text="这里将放置当前功能分区的真实页面内容。"
                                               FontSize="14"
                                               TextWrapping="Wrap"
                                               Foreground="#64748B"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
