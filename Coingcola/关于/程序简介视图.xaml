<UserControl x:Class="Coingcola.视图层.关于.程序简介视图"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="Transparent">

    <ScrollViewer x:Name="根滚动容器"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Background="Transparent"
                  PreviewMouseWheel="根滚动容器_PreviewMouseWheel">
        <StackPanel Margin="0,0,4,0">

            <StackPanel Margin="0,0,0,20">
                <TextBlock Text="程序简介"
                           FontSize="30"
                           FontWeight="Bold"
                           Foreground="#0F172A"/>
                <TextBlock Text="帮助用户理解 Coingcola 是什么、解决什么问题，以及当前已经走到哪一步。"
                           Margin="0,10,0,0"
                           FontSize="14"
                           Foreground="#64748B"/>
            </StackPanel>

            <Border Background="#F8FAFC"
                    BorderBrush="#E2E8F0"
                    BorderThickness="1"
                    CornerRadius="24"
                    Padding="24"
                    Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="产品定位"
                               FontSize="13"
                               Foreground="#64748B"/>
                    <TextBlock x:Name="产品名称文本"
                               Margin="0,12,0,0"
                               Text="产品名称"
                               FontSize="28"
                               FontWeight="Bold"
                               Foreground="#0F172A"/>
                    <TextBlock x:Name="核心口号文本"
                               Margin="0,12,0,0"
                               Text="核心口号"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="#334155"/>
                    <TextBlock x:Name="页面结论文本"
                               Margin="0,16,0,0"
                               Text="页面结论"
                               FontSize="14"
                               TextWrapping="Wrap"
                               Foreground="#475569"/>
                </StackPanel>
            </Border>

            <ItemsControl x:Name="摘要卡片列表"
                          Margin="0,0,0,20">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Width="240"
                                Margin="0,0,12,12"
                                Padding="16"
                                CornerRadius="18"
                                Background="White"
                                BorderBrush="#E5E7EB"
                                BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="{Binding 标题}"
                                           FontSize="13"
                                           Foreground="#64748B"/>
                                <TextBlock Text="{Binding 数值}"
                                           Margin="0,10,0,0"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           TextWrapping="Wrap"
                                           Foreground="#0F172A"/>
                                <TextBlock Text="{Binding 说明}"
                                           Margin="0,8,0,0"
                                           FontSize="11"
                                           TextWrapping="Wrap"
                                           Foreground="#94A3B8"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <ItemsControl x:Name="分组列表控件">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="White"
                                BorderBrush="#E5E7EB"
                                BorderThickness="1"
                                CornerRadius="20"
                                Padding="18"
                                Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="{Binding 标题}"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           Foreground="#0F172A"/>
                                <TextBlock Text="{Binding 简介}"
                                           Margin="0,8,0,0"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           Foreground="#64748B"/>

                                <ItemsControl ItemsSource="{Binding 项列表}"
                                              Margin="0,16,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="#E2E8F0"
                                                    BorderThickness="0,0,0,1"
                                                    Padding="0,0,0,12"
                                                    Margin="0,0,0,12">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="180"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Text="{Binding 名称}"
                                                               FontSize="13"
                                                               FontWeight="SemiBold"
                                                               Foreground="#334155"/>

                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="{Binding 值}"
                                                                   FontSize="14"
                                                                   TextWrapping="Wrap"
                                                                   Foreground="#0F172A"/>
                                                        <TextBlock Text="{Binding 说明}"
                                                                   Margin="0,6,0,0"
                                                                   FontSize="11"
                                                                   TextWrapping="Wrap"
                                                                   Foreground="#94A3B8"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </StackPanel>
    </ScrollViewer>
</UserControl>